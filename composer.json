{
    "name": "leadveyor/leadveyor-php",
    "description": "Official PHP client for the Leadveyor API: lead scoring, sources, webhooks.",
    "type": "library",
    "license": "MIT",
    "keywords": ["leadveyor", "lead scoring", "leads", "crm", "api", "sdk", "webhooks"],
    "homepage": "https://leadveyor.com/docs/sdk/php",
    "support": {
        "email": "support@leadveyor.com",
        "docs": "https://leadveyor.com/docs/sdk/php"
    },
    "authors": [
        { "name": "Leadveyor", "email": "support@leadveyor.com", "homepage": "https://leadveyor.com" }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": { "Leadveyor\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Leadveyor\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    }
}
